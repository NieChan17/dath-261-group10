# ==============================================================================
# EduPulse LMS - Environment Configuration Template
# Copy this file to .env and fill in strong unique secrets before running Docker Compose.
# Never commit .env with real credentials.
# ==============================================================================

# --- Runtime Environment ---
# development | staging | production
NODE_ENV=production
APP_ENV=production
PORT=5000

# --- PostgreSQL (pgvector) ---
DB_USER=edupulse_user
# Alphanumeric only (avoid @ # / : ? in passwords interpolated into DATABASE_URL)
DB_PASSWORD=CHANGE_ME_STRONG_ALPHANUMERIC_DB_PASSWORD
DB_NAME=edupulse_prod
# Localhost bind port for docker-compose.yml development stack
DB_PORT=5432
DATABASE_SSL=false

# --- Authentication & Security (Required in staging/production) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_CHARS_ACCESS_SECRET
JWT_EXPIRES_IN=1h
# Generate a separate secret with: openssl rand -hex 32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_CHARS_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (no wildcard in production)
CORS_ORIGIN=https://your-domain.example.com
# Set true behind HTTPS (default in production), false only for local HTTP staging tests
COOKIE_SECURE=true
# Swagger UI is disabled in staging/production by default unless explicitly set true
ENABLE_SWAGGER=false

# --- Migrations & Demo Account Seeding ---
RUN_MIGRATIONS_ON_BOOT=true
RUN_SEED_ON_BOOT=false
DISABLE_DEMO_SEED=false
# Override demo account passwords before seeding public environments:
SEED_ADMIN_PASSWORD=Admin@123456
SEED_INSTRUCTOR_PASSWORD=Instructor@123456
SEED_STUDENT_PASSWORD=Student@123456

# --- AI RAG Service (service/ai-service) ---
# Generate with: openssl rand -hex 32
AI_INTERNAL_TOKEN=CHANGE_ME_GENERATE_AI_INTERNAL_TOKEN
AI_PORT=8000
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
OOS_THRESHOLD=0.55

# --- Frontend & Reverse Proxy ---
NEXT_PUBLIC_API_URL=/api
DOMAIN_NAME=your-domain.example.com
CERTBOT_EMAIL=ops@your-domain.example.com
