# Letters and digits only: characters such as @ # / : break the database URL.
DB_PASSWORD=secure_staging_password
DB_NAME=edupulse_staging
PORT=5000
# Host port for PostgreSQL, bound to 127.0.0.1 only. Change if 5432 is already used on your machine.
DB_PORT=5432

# --- AI service (service/ai-service) ---
# development | staging | production. Outside development the service refuses to start without AI_INTERNAL_TOKEN.
APP_ENV=development
# Shared secret between the backend and the AI service, sent as the X-Internal-Token header.
AI_INTERNAL_TOKEN=
# Host port for the AI service, bound to 127.0.0.1 only.
AI_PORT=8000
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
OOS_THRESHOLD=0.65
