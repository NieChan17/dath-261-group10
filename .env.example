# Copy to .env (same folder as docker-compose.yml) and fill in your own values. Never commit .env.

APP_ENV=development

POSTGRES_USER=edupulse
# Required. Use letters and digits only: characters such as @ # / : break the database URL.
POSTGRES_PASSWORD=
POSTGRES_DB=edupulse
# Change if port 5432 is already used on your machine.
DB_PORT=5432

# Change if port 8000 is already used on your machine.
AI_PORT=8000
# Leave empty in development. Required when APP_ENV is staging or production.
AI_INTERNAL_TOKEN=
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
OOS_THRESHOLD=0.65
