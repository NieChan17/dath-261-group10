# ==============================================================================
# EduPulse Backend - Environment Configuration Template
# Copy to backend/.env for local non-Docker development.
# Outside development, backend refuses to boot with weak or missing JWT secrets.
# ==============================================================================

PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://edupulse_user:CHANGE_ME_LOCAL_DB_PASSWORD@localhost:5432/edupulse_staging
DATABASE_SSL=false

# Generate 64-char hex keys via: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LOCAL_JWT_ACCESS_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=CHANGE_ME_LOCAL_JWT_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
ENABLE_SWAGGER=true

AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=CHANGE_ME_LOCAL_AI_INTERNAL_TOKEN

# Optional seed overrides (used by `npm run db:seed`)
DISABLE_DEMO_SEED=false
SEED_ADMIN_PASSWORD=Admin@123456
SEED_INSTRUCTOR_PASSWORD=Instructor@123456
SEED_STUDENT_PASSWORD=Student@123456
